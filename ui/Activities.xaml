<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="ActivitiesWindow"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource OverlayBg}"
        AllowsTransparency="False"
        FontFamily="Segoe UI Variable Text">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBg" Color="#242424"/>
    <SolidColorBrush x:Key="OverlayBg" Color="#F4222222"/>
    <SolidColorBrush x:Key="CardBg" Color="#3B3B3B"/>
    <SolidColorBrush x:Key="CardHover" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Muted" Color="#C9C9C9"/>
    <SolidColorBrush x:Key="Border" Color="#555555"/>
    <SolidColorBrush x:Key="Accent" Color="#3584E4"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF"/>

    <Style x:Key="ChromeButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CardHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.78"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AppButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
      <Setter Property="Width" Value="112"/>
      <Setter Property="Height" Value="96"/>
      <Setter Property="Margin" Value="7"/>
      <Setter Property="Padding" Value="8"/>
    </Style>

    <Style x:Key="DashButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
      <Setter Property="Width" Value="52"/>
      <Setter Property="Height" Value="52"/>
      <Setter Property="Margin" Value="3,0"/>
      <Setter Property="Padding" Value="6"/>
    </Style>

    <Style x:Key="PageDotButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
      <Setter Property="Height" Value="7"/>
      <Setter Property="MinWidth" Value="7"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="{DynamicResource Muted}"/>
      <Setter Property="Opacity" Value="0.55"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="WorkspaceNavButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
      <Setter Property="Width" Value="42"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="Background" Value="#663B3B3B"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="68"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="84"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="20,14,20,8">
      <Border Width="420" Height="40" HorizontalAlignment="Center" CornerRadius="20"
              Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="42"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="34"/>
          </Grid.ColumnDefinitions>

          <Viewbox Grid.Column="0" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="20" Height="20">
              <Ellipse Width="10.5" Height="10.5" Canvas.Left="2.5" Canvas.Top="2.5"
                       Stroke="{DynamicResource Muted}" StrokeThickness="2"/>
              <Path Stroke="{DynamicResource Muted}" StrokeThickness="2" StrokeStartLineCap="Round"
                    Data="M11,11 L17,17"/>
            </Canvas>
          </Viewbox>

          <Grid Grid.Column="1">
            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource Foreground}" FontSize="15"
                     VerticalContentAlignment="Center" CaretBrush="{DynamicResource Foreground}"/>
            <TextBlock x:Name="SearchHint" Text="Type to search" Foreground="{DynamicResource Muted}"
                       FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False"/>
          </Grid>

          <Button x:Name="ClearSearchButton" Grid.Column="2" Style="{StaticResource ChromeButtonStyle}"
                  Width="28" Height="28" Padding="0" VerticalAlignment="Center" Visibility="Collapsed">
            <Viewbox Width="11" Height="11">
              <Path Stroke="{DynamicResource Foreground}" StrokeThickness="2" StrokeStartLineCap="Round"
                    Data="M2,2 L10,10 M10,2 L2,10"/>
            </Viewbox>
          </Button>
        </Grid>
      </Border>
    </Grid>

    <Grid x:Name="OverviewView" Grid.Row="1" Margin="22,2,22,4">
      <Grid.RowDefinitions>
        <RowDefinition Height="50"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <StackPanel x:Name="WorkspaceStrip" Grid.Row="0" Orientation="Horizontal"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button x:Name="PreviousWorkspaceButton" Style="{StaticResource WorkspaceNavButtonStyle}"
                Width="40" Height="32" Margin="4,0" ToolTip="Previous Workspace">
          <Viewbox Width="9" Height="14">
            <Path Stroke="{DynamicResource Foreground}" StrokeThickness="2" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" Data="M8,1 L2,7 L8,13"/>
          </Viewbox>
        </Button>

        <Border Width="76" Height="40" Margin="5,0" CornerRadius="8"
                Background="#151515" BorderBrush="{DynamicResource Accent}" BorderThickness="2">
          <Grid>
            <Border Margin="7" CornerRadius="4" Background="{DynamicResource CardBg}"/>
            <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentForeground}"
                     HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
          </Grid>
        </Border>

        <Button x:Name="NextWorkspaceButton" Style="{StaticResource WorkspaceNavButtonStyle}"
                Width="40" Height="32" Margin="4,0" ToolTip="Next Workspace">
          <Viewbox Width="9" Height="14">
            <Path Stroke="{DynamicResource Foreground}" StrokeThickness="2" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" Data="M2,1 L8,7 L2,13"/>
          </Viewbox>
        </Button>

        <Button x:Name="NewWorkspaceButton" Style="{StaticResource WorkspaceNavButtonStyle}"
                Width="40" Height="32" Margin="12,0,4,0" ToolTip="New Workspace">
          <Viewbox Width="13" Height="13">
            <Path Stroke="{DynamicResource Foreground}" StrokeThickness="2"
                  StrokeStartLineCap="Round" Data="M6.5,1 L6.5,12 M1,6.5 L12,6.5"/>
          </Viewbox>
        </Button>
      </StackPanel>

      <Button x:Name="WorkspaceButton" Grid.Row="1" Style="{StaticResource ChromeButtonStyle}"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="Transparent" Padding="0">
        <Border x:Name="WorkspaceCard" Width="720" Height="405" CornerRadius="14"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                Background="#151515" ClipToBounds="True">
          <Image x:Name="WorkspacePreview" Stretch="UniformToFill"/>
        </Border>
      </Button>
    </Grid>

    <Grid x:Name="SearchResultsView" Grid.Row="1" Visibility="Collapsed" Margin="28,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <TextBlock Text="Search results" Foreground="{DynamicResource Foreground}"
                 FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,14"/>
      <Grid Grid.Row="1">
        <WrapPanel x:Name="SearchResultsPanel" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="860"/>
        <TextBlock x:Name="NoResultsText" Text="No matching applications"
                   Foreground="{DynamicResource Muted}" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
      </Grid>
    </Grid>

    <Grid x:Name="AppsView" Grid.Row="1" Visibility="Collapsed" Margin="28,2,28,4">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="26"/>
      </Grid.RowDefinitions>

      <Grid>
        <Button x:Name="BackToOverviewButton" Style="{StaticResource WorkspaceNavButtonStyle}"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0" Visibility="Collapsed">
          <Viewbox Width="13" Height="20">
            <Path Stroke="{DynamicResource Foreground}" StrokeThickness="2.3" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" Data="M11,2 L3,10 L11,18"/>
          </Viewbox>
        </Button>
        <WrapPanel x:Name="AppPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="780"/>
      </Grid>

      <StackPanel x:Name="AppPageDotsPanel" Grid.Row="1" Orientation="Horizontal"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>

    <Grid Grid.Row="2" VerticalAlignment="Center">
      <Border x:Name="OverviewDashBorder" Height="68" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}"
              BorderThickness="1" CornerRadius="24" Padding="10,7">
        <StackPanel x:Name="DashPanel" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ShowAppsButton" Style="{StaticResource DashButtonStyle}" ToolTip="Show Applications">
            <Viewbox Width="22" Height="22">
              <UniformGrid Rows="3" Columns="3">
                <Ellipse Width="4" Height="4" Fill="{DynamicResource Foreground}" Margin="1"/>
                <Ellipse Width="4" Height="4" Fill="{DynamicResource Foreground}" Margin="1"/>
                <Ellipse Width="4" Height="4" Fill="{DynamicResource Foreground}" Margin="1"/>
                <Ellipse Width="4" Height="4" Fill="{DynamicResource Foreground}" Margin="1"/>
                <Ellipse Width="4" Height="4" Fill="{DynamicResource Foreground}" Margin="1"/>
                <Ellipse Width="4" Height="4" Fill="{DynamicResource Foreground}" Margin="1"/>
                <Ellipse Width="4" Height="4" Fill="{DynamicResource Foreground}" Margin="1"/>
                <Ellipse Width="4" Height="4" Fill="{DynamicResource Foreground}" Margin="1"/>
                <Ellipse Width="4" Height="4" Fill="{DynamicResource Foreground}" Margin="1"/>
              </UniformGrid>
            </Viewbox>
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
