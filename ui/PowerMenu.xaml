<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="PowerWindow"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        Width="280" Height="292"
        FontFamily="Segoe UI Variable Text">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBg" Color="#242424"/>
    <SolidColorBrush x:Key="OverlayBg" Color="#242424"/>
    <SolidColorBrush x:Key="CardBg" Color="#353535"/>
    <SolidColorBrush x:Key="CardHover" Color="#474747"/>
    <SolidColorBrush x:Key="Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Muted" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="Border" Color="#4B4B4B"/>
    <SolidColorBrush x:Key="Accent" Color="#3584E4"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF"/>
    <Style x:Key="PowerRowStyle" TargetType="Button">
      <Setter Property="Height" Value="44"/><Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="14,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Foreground}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CardHover}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border Margin="8" CornerRadius="18" Background="{DynamicResource OverlayBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
    <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.32" Color="#000000"/></Border.Effect>
    <Grid Margin="12">
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="Power" Foreground="{DynamicResource Foreground}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0"/>
      <StackPanel Grid.Row="1">
        <Button x:Name="LockButton" Style="{StaticResource PowerRowStyle}" Content="Lock"/>
        <Button x:Name="SuspendButton" Style="{StaticResource PowerRowStyle}" Content="Suspend"/>
        <Button x:Name="RestartButton" Style="{StaticResource PowerRowStyle}" Content="Restart"/>
        <Button x:Name="PowerOffButton" Style="{StaticResource PowerRowStyle}" Content="Power Off"/>
        <Button x:Name="LogOutButton" Style="{StaticResource PowerRowStyle}" Content="Log Out"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
