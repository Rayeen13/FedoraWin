<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="CalendarWindow"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        Width="680" Height="420"
        FontFamily="Segoe UI Variable Text">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBg" Color="#242424"/>
    <SolidColorBrush x:Key="OverlayBg" Color="#242424"/>
    <SolidColorBrush x:Key="CardBg" Color="#353535"/>
    <SolidColorBrush x:Key="CardHover" Color="#484848"/>
    <SolidColorBrush x:Key="Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Muted" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="Border" Color="#4B4B4B"/>
    <SolidColorBrush x:Key="Accent" Color="#3584E4"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF"/>

    <Style x:Key="FlatButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CardHover}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DayButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Resources>

  <Border Margin="8" CornerRadius="18" Background="{DynamicResource OverlayBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
    <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.36" Color="#000000"/></Border.Effect>
    <Grid Margin="22">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="245"/>
        <ColumnDefinition Width="1"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" Margin="2,2,20,2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="WeekdayTitle" Foreground="{DynamicResource Muted}" FontSize="14" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="1" Margin="0,5,0,0">
          <TextBlock x:Name="DateTitle" Foreground="{DynamicResource Foreground}" FontSize="31" FontWeight="SemiBold"/>
          <TextBlock x:Name="YearTitle" Foreground="{DynamicResource Muted}" FontSize="15" Margin="1,2,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,28,0,0">
          <TextBlock Text="Notifications" Foreground="{DynamicResource Foreground}" FontSize="15" FontWeight="SemiBold"/>
          <Border Margin="0,12,0,0" Padding="14" CornerRadius="13" Background="{DynamicResource CardBg}">
            <StackPanel>
              <TextBlock Text="No notifications" Foreground="{DynamicResource Foreground}" FontSize="13" FontWeight="SemiBold"/>
              <TextBlock Text="You're all caught up" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <Button Grid.Row="3" x:Name="OpenCalendarButton" Style="{StaticResource FlatButtonStyle}" HorizontalAlignment="Left" Padding="12,7" Margin="-6,8,0,-4" Content="Open Calendar"/>
      </Grid>

      <Border Grid.Column="1" Background="{DynamicResource Border}"/>

      <Grid Grid.Column="2" Margin="24,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="48"/>
          <RowDefinition Height="28"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Button x:Name="PrevMonthButton" Style="{StaticResource FlatButtonStyle}" Width="38" Height="38" HorizontalAlignment="Left" ToolTip="Previous month">
            <Path Stroke="{DynamicResource Foreground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,3 L6,9 L12,15"/>
          </Button>
          <TextBlock x:Name="MonthTitle" Foreground="{DynamicResource Foreground}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Button x:Name="NextMonthButton" Style="{StaticResource FlatButtonStyle}" Width="38" Height="38" HorizontalAlignment="Right" ToolTip="Next month">
            <Path Stroke="{DynamicResource Foreground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M6,3 L12,9 L6,15"/>
          </Button>
        </Grid>
        <UniformGrid Grid.Row="1" Columns="7" Rows="1" Margin="0,2,0,0">
          <TextBlock Text="Mon" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Center"/>
          <TextBlock Text="Tue" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Center"/>
          <TextBlock Text="Wed" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Center"/>
          <TextBlock Text="Thu" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Center"/>
          <TextBlock Text="Fri" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Center"/>
          <TextBlock Text="Sat" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Center"/>
          <TextBlock Text="Sun" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Center"/>
        </UniformGrid>
        <UniformGrid x:Name="CalendarDaysPanel" Grid.Row="2" Columns="7" Rows="6" Margin="0,8,0,0"/>
      </Grid>
    </Grid>
  </Border>
</Window>
