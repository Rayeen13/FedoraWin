<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="QuickWindow"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        Width="486" Height="426"
        FontFamily="Segoe UI Variable Text">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBg" Color="#242424"/>
    <SolidColorBrush x:Key="OverlayBg" Color="#303030"/>
    <SolidColorBrush x:Key="CardBg" Color="#454545"/>
    <SolidColorBrush x:Key="CardHover" Color="#515151"/>
    <SolidColorBrush x:Key="Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Muted" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="Border" Color="#5B5B5B"/>
    <SolidColorBrush x:Key="Accent" Color="#3584E4"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF"/>

    <Style x:Key="CircleButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
      <Setter Property="Background" Value="{DynamicResource CardBg}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="20">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CardHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="QuickTileStyle" TargetType="Button">
      <Setter Property="Width" Value="205"/>
      <Setter Property="Height" Value="60"/>
      <Setter Property="Margin" Value="5"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
      <Setter Property="Background" Value="{DynamicResource CardBg}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CardHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.76"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.42"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GnomeSlider" TargetType="Slider">
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="100"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="28">
              <Track x:Name="PART_Track" VerticalAlignment="Center" Height="8">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" BorderThickness="0" Background="{DynamicResource Accent}">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" CornerRadius="4"/></ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="18" Height="18">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="{DynamicResource Foreground}" Stroke="{DynamicResource Foreground}" StrokeThickness="1"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" BorderThickness="0" Background="#555555">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" CornerRadius="4"/></ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Margin="8" CornerRadius="26" Background="{DynamicResource OverlayBg}"
          BorderBrush="{DynamicResource Border}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="7" Opacity="0.36" Color="#000000"/>
    </Border.Effect>

    <Grid Margin="20,18,20,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="48"/>
        <RowDefinition Height="48"/>
        <RowDefinition Height="48"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border HorizontalAlignment="Left" VerticalAlignment="Center" Height="38" Padding="13,0"
                CornerRadius="19" Background="{DynamicResource CardBg}">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="24" Height="14" Margin="0,0,8,0">
              <Border BorderBrush="{DynamicResource Foreground}" BorderThickness="1.5" CornerRadius="2.5" Margin="0,0,4,0"/>
              <Rectangle Fill="{DynamicResource Foreground}" Width="3" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              <Rectangle x:Name="BatteryFill" Fill="{DynamicResource Foreground}" Height="8"
                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" Width="13"/>
            </Grid>
            <TextBlock x:Name="BatteryText" Text="Power" Foreground="{DynamicResource Foreground}"
                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ScreenshotButton" Style="{StaticResource CircleButtonStyle}" ToolTip="Take Screenshot">
            <Viewbox Width="18" Height="18">
              <Canvas Width="20" Height="20">
                <Path Stroke="{DynamicResource Foreground}" StrokeThickness="1.7" StrokeLineJoin="Round"
                      Data="M4,6 L7,6 L8.3,4 L11.7,4 L13,6 L16,6 C17.1,6 18,6.9 18,8 L18,15 C18,16.1 17.1,17 16,17 L4,17 C2.9,17 2,16.1 2,15 L2,8 C2,6.9 2.9,6 4,6 Z"/>
                <Ellipse Width="6" Height="6" Canvas.Left="7" Canvas.Top="8.5"
                         Stroke="{DynamicResource Foreground}" StrokeThickness="1.7"/>
              </Canvas>
            </Viewbox>
          </Button>

          <Button x:Name="SettingsButton" Style="{StaticResource CircleButtonStyle}" ToolTip="Settings">
            <Viewbox Width="18" Height="18">
              <Canvas Width="20" Height="20">
                <Ellipse Width="6" Height="6" Canvas.Left="7" Canvas.Top="7"
                         Stroke="{DynamicResource Foreground}" StrokeThickness="1.8"/>
                <Path Stroke="{DynamicResource Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round"
                      Data="M10,2 L10,5 M10,15 L10,18 M2,10 L5,10 M15,10 L18,10 M4.3,4.3 L6.4,6.4 M13.6,13.6 L15.7,15.7 M15.7,4.3 L13.6,6.4 M6.4,13.6 L4.3,15.7"/>
              </Canvas>
            </Viewbox>
          </Button>

          <Button x:Name="QuickLockButton" Style="{StaticResource CircleButtonStyle}" ToolTip="Lock Screen">
            <Viewbox Width="17" Height="17">
              <Canvas Width="20" Height="20">
                <Border Width="12" Height="10" Canvas.Left="4" Canvas.Top="8"
                        BorderBrush="{DynamicResource Foreground}" BorderThickness="1.8" CornerRadius="2"/>
                <Path Stroke="{DynamicResource Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round"
                      Data="M6.5,8 L6.5,6 C6.5,3.8 8,2.5 10,2.5 C12,2.5 13.5,3.8 13.5,6 L13.5,8"/>
              </Canvas>
            </Viewbox>
          </Button>

          <Button x:Name="PowerButton" Style="{StaticResource CircleButtonStyle}" ToolTip="Power Menu">
            <Viewbox Width="17" Height="17">
              <Canvas Width="20" Height="20">
                <Path Stroke="{DynamicResource Foreground}" StrokeThickness="1.9" StrokeStartLineCap="Round"
                      Data="M10,2 L10,9 M5.6,4.4 C3.7,5.8 2.5,8 2.5,10.5 C2.5,14.6 5.9,18 10,18 C14.1,18 17.5,14.6 17.5,10.5 C17.5,8 16.3,5.8 14.4,4.4"/>
              </Canvas>
            </Viewbox>
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="8,3,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
          <Canvas Width="20" Height="20">
            <Path Fill="{DynamicResource Foreground}" Data="M2,8 L6,8 L11,4 L11,16 L6,12 L2,12 Z"/>
            <Path Stroke="{DynamicResource Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round"
                  Data="M13,7 C14.5,8.5 14.5,11.5 13,13 M15.5,4.5 C19,8 19,12 15.5,15.5"/>
          </Canvas>
        </Viewbox>
        <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource GnomeSlider}"
                Value="68" Margin="10,0,0,0" ToolTip="Master Volume"/>
      </Grid>

      <Grid Grid.Row="2" Margin="8,0,8,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
          <Canvas Width="20" Height="20">
            <Ellipse Width="7" Height="7" Canvas.Left="6.5" Canvas.Top="6.5"
                     Stroke="{DynamicResource Foreground}" StrokeThickness="1.6"/>
            <Path Stroke="{DynamicResource Foreground}" StrokeThickness="1.5" StrokeStartLineCap="Round"
                  Data="M10,1 L10,4 M10,16 L10,19 M1,10 L4,10 M16,10 L19,10 M3.6,3.6 L5.7,5.7 M14.3,14.3 L16.4,16.4 M16.4,3.6 L14.3,5.7 M5.7,14.3 L3.6,16.4"/>
          </Canvas>
        </Viewbox>
        <Slider x:Name="BrightnessSlider" Grid.Column="1" Style="{StaticResource GnomeSlider}"
                Value="70" Margin="10,0,0,0" ToolTip="Display Brightness"/>
      </Grid>

      <WrapPanel x:Name="QuickTilesPanel" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="-5,4,-5,-5">
        <Button x:Name="WifiButton" Style="{StaticResource QuickTileStyle}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Viewbox Width="19" Height="16" VerticalAlignment="Center">
              <Canvas Width="20" Height="16">
                <Path Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" Data="M2,5 C6,1.5 14,1.5 18,5 M5,8 C8,5.7 12,5.7 15,8 M8.2,11 C9.3,10.2 10.7,10.2 11.8,11"/>
                <Ellipse Width="2.8" Height="2.8" Canvas.Left="8.6" Canvas.Top="12.5"
                         Fill="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}"/>
              </Canvas>
            </Viewbox>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="WifiText" Text="Wi-Fi" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock x:Name="WifiSubText" Text="Checking" FontSize="10.5" Opacity="0.82"/>
            </StackPanel>
          </Grid>
        </Button>

        <Button x:Name="BluetoothButton" Style="{StaticResource QuickTileStyle}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Viewbox Width="17" Height="19" VerticalAlignment="Center">
              <Path Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" StrokeThickness="1.7"
                    StrokeLineJoin="Round" Data="M8,1 L14,6 L8,10 L14,15 L8,19 L8,1 M3,5 L14,15 M3,15 L14,6"/>
            </Viewbox>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="BluetoothText" Text="Bluetooth" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock x:Name="BluetoothSubText" Text="Checking" FontSize="10.5" Opacity="0.82"/>
            </StackPanel>
          </Grid>
        </Button>

        <Button x:Name="PowerModeButton" Style="{StaticResource QuickTileStyle}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Viewbox Width="19" Height="19" VerticalAlignment="Center">
              <Canvas Width="20" Height="20">
                <Path Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" Data="M3,14 C2,11 2.8,6.5 6.2,4.2 C9.6,1.9 14.2,2.8 16.7,5.6 C18.7,7.9 18.5,11 17.2,13.5"/>
                <Path Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" Data="M10,10 L14.5,6.8"/>
                <Ellipse Width="3" Height="3" Canvas.Left="8.5" Canvas.Top="8.5"
                         Fill="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}"/>
              </Canvas>
            </Viewbox>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="PowerModeText" Text="Balanced" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock Text="Power Mode" FontSize="10.5" Opacity="0.82"/>
            </StackPanel>
          </Grid>
        </Button>

        <Button x:Name="DarkStyleButton" Style="{StaticResource QuickTileStyle}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Viewbox Width="18" Height="18" VerticalAlignment="Center">
              <Canvas Width="20" Height="20">
                <Ellipse Width="16" Height="16" Canvas.Left="2" Canvas.Top="2"
                         Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" StrokeThickness="1.6"/>
                <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}"
                      Data="M10,2 A8,8 0 0 0 10,18 Z"/>
              </Canvas>
            </Viewbox>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="DarkStyleTitle" Text="Dark Style" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock Text="Appearance" FontSize="10.5" Opacity="0.82"/>
            </StackPanel>
          </Grid>
        </Button>

        <Button x:Name="AirplaneButton" Style="{StaticResource QuickTileStyle}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Viewbox Width="19" Height="19" VerticalAlignment="Center">
              <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}"
                    Data="M2,9 L8,7 L11,1 L13,1 L12,7 L18,9 L18,11 L12,10 L13,18 L11,18 L8,11 L2,11 Z"/>
            </Viewbox>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="Airplane Mode" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock x:Name="AirplaneSubText" Text="Radios on" FontSize="10.5" Opacity="0.82"/>
            </StackPanel>
          </Grid>
        </Button>

        <Button x:Name="AppearanceButton" Style="{StaticResource QuickTileStyle}" Visibility="Collapsed" IsHitTestVisible="False">
          <StackPanel><TextBlock Text="Appearance"/><TextBlock x:Name="AppearanceSubText" Text="Theme and accent"/></StackPanel>
        </Button>

        <Button x:Name="NightLightButton" Style="{StaticResource QuickTileStyle}" Visibility="Collapsed" IsEnabled="False" IsHitTestVisible="False">
          <StackPanel><TextBlock Text="Night Light"/><TextBlock x:Name="NightLightSubText" Text="Windows API unavailable"/></StackPanel>
        </Button>

        <Button x:Name="MoreSettingsButton" Visibility="Collapsed" IsHitTestVisible="False"/>
        <TextBlock x:Name="StatusText" Visibility="Collapsed" Text="FedoraWin"/>
      </WrapPanel>
    </Grid>
  </Border>
</Window>
