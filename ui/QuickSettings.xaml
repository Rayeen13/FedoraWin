<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="QuickWindow"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        Width="410" Height="470"
        FontFamily="Segoe UI Variable Text">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBg" Color="#242424"/>
    <SolidColorBrush x:Key="OverlayBg" Color="#242424"/>
    <SolidColorBrush x:Key="CardBg" Color="#353535"/>
    <SolidColorBrush x:Key="CardHover" Color="#474747"/>
    <SolidColorBrush x:Key="Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Muted" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="Border" Color="#4B4B4B"/>
    <SolidColorBrush x:Key="Accent" Color="#3584E4"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF"/>

    <Style x:Key="CircleButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Margin" Value="3,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
      <Setter Property="Background" Value="{DynamicResource CardBg}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="19"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="QuickTileStyle" TargetType="Button">
      <Setter Property="Height" Value="56"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="14,7"/>
      <Setter Property="Foreground" Value="{DynamicResource Foreground}"/><Setter Property="Background" Value="{DynamicResource CardBg}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="GnomeSlider" TargetType="Slider">
      <Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/><Setter Property="Height" Value="28"/><Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="28"><Track x:Name="PART_Track" VerticalAlignment="Center" Height="8"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" BorderThickness="0" Background="{DynamicResource Accent}"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" CornerRadius="4"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="18" Height="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource Accent}" Stroke="{DynamicResource AccentForeground}" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" BorderThickness="0" Background="{DynamicResource CardBg}"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" CornerRadius="4"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Border Margin="8" CornerRadius="18" Background="{DynamicResource OverlayBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
    <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.32" Color="#000000"/></Border.Effect>
    <Grid Margin="16">
      <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="48"/><RowDefinition Height="48"/><RowDefinition Height="184"/><RowDefinition Height="54"/><RowDefinition Height="42"/></Grid.RowDefinitions>
      <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border HorizontalAlignment="Left" VerticalAlignment="Center" Padding="10,6" CornerRadius="12" Background="{DynamicResource CardBg}"><StackPanel Orientation="Horizontal"><Grid Width="22" Height="12" Margin="0,0,8,0"><Border BorderBrush="{DynamicResource Foreground}" BorderThickness="1.4" CornerRadius="2" Margin="0,0,3,0"/><Rectangle Fill="{DynamicResource Foreground}" Width="2.5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center"/><Rectangle x:Name="BatteryFill" Fill="{DynamicResource Foreground}" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Width="13"/></Grid><TextBlock x:Name="BatteryText" Text="Power" Foreground="{DynamicResource Foreground}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Border><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ScreenshotButton" Style="{StaticResource CircleButtonStyle}" ToolTip="Screenshot"><TextBlock Text="[]"/></Button><Button x:Name="SettingsButton" Style="{StaticResource CircleButtonStyle}" ToolTip="Settings"><TextBlock Text="o"/></Button><Button x:Name="PowerButton" Style="{StaticResource CircleButtonStyle}" ToolTip="Power menu"><TextBlock Text="|"/></Button></StackPanel></Grid>
      <Grid Grid.Row="1" Margin="8,4,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Vol" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" FontSize="9"/><Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource GnomeSlider}" Value="68" Margin="10,0,0,0" ToolTip="Master volume"/></Grid>
      <Grid Grid.Row="2" Margin="8,0,8,4"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Sun" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" FontSize="9"/><Slider x:Name="BrightnessSlider" Grid.Column="1" Style="{StaticResource GnomeSlider}" Value="70" Margin="10,0,0,0" ToolTip="Display brightness"/></Grid>
      <UniformGrid Grid.Row="3" Columns="2" Rows="3" Margin="0,2"><Button x:Name="WifiButton" Style="{StaticResource QuickTileStyle}"><StackPanel><TextBlock x:Name="WifiText" Text="Wi-Fi" FontWeight="SemiBold"/><TextBlock x:Name="WifiSubText" Text="Checking" FontSize="10" Opacity="0.78"/></StackPanel></Button><Button x:Name="BluetoothButton" Style="{StaticResource QuickTileStyle}"><StackPanel><TextBlock x:Name="BluetoothText" Text="Bluetooth" FontWeight="SemiBold"/><TextBlock x:Name="BluetoothSubText" Text="Checking" FontSize="10" Opacity="0.78"/></StackPanel></Button><Button x:Name="PowerModeButton" Style="{StaticResource QuickTileStyle}"><StackPanel><TextBlock x:Name="PowerModeText" Text="Balanced" FontWeight="SemiBold"/><TextBlock Text="Power Mode" FontSize="10" Opacity="0.78"/></StackPanel></Button><Button x:Name="DarkStyleButton" Style="{StaticResource QuickTileStyle}"><StackPanel><TextBlock x:Name="DarkStyleTitle" Text="Dark Style" FontWeight="SemiBold"/><TextBlock Text="Appearance" FontSize="10" Opacity="0.78"/></StackPanel></Button><Button x:Name="AirplaneButton" Style="{StaticResource QuickTileStyle}"><StackPanel><TextBlock Text="Airplane Mode" FontWeight="SemiBold"/><TextBlock x:Name="AirplaneSubText" Text="Radios on" FontSize="10" Opacity="0.78"/></StackPanel></Button><Button x:Name="AppearanceButton" Style="{StaticResource QuickTileStyle}"><StackPanel><TextBlock Text="Appearance" FontWeight="SemiBold"/><TextBlock x:Name="AppearanceSubText" Text="Theme and accent" FontSize="10" Opacity="0.78"/></StackPanel></Button></UniformGrid>
      <Border Grid.Row="4" Margin="4,4" CornerRadius="14" Background="{DynamicResource CardBg}" Padding="12,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Night Light" Foreground="{DynamicResource Foreground}" FontWeight="SemiBold"/><TextBlock x:Name="NightLightSubText" Text="Windows API unavailable" Foreground="{DynamicResource Muted}" FontSize="10"/></StackPanel><Button x:Name="NightLightButton" Grid.Column="1" Style="{StaticResource CircleButtonStyle}" Width="34" Height="34" IsEnabled="False" ToolTip="Not exposed through a stable public desktop API"><TextBlock Text="i" Foreground="{DynamicResource Muted}" FontWeight="Bold"/></Button></Grid></Border>
      <Grid Grid.Row="5" Margin="4,2,4,0"><Button x:Name="MoreSettingsButton" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Muted}" HorizontalAlignment="Left" Cursor="Hand" FontSize="12" Content="Settings"/><TextBlock x:Name="StatusText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="10" Text="FedoraWin"/></Grid>
    </Grid>
  </Border>
</Window>
